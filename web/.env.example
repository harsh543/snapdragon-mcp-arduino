# Public tunnel URL for GenieX's OpenAI-compatible server on the Snapdragon
# X Elite (e.g. an ngrok/Cloudflare Tunnel forward of http://127.0.0.1:18181).
# Must include the /v1 suffix.
GENIEX_URL=https://your-geniex-tunnel.example.com/v1

# Model name as pulled via `geniex pull`.
GENIEX_MODEL=qualcomm/Qwen3-4B-Instruct-2507

# Public tunnel URL for the FastMCP server on the Arduino Uno Q (a second,
# separate tunnel from GENIEX_URL - the Uno Q's ADB-forwarded port 3001 is
# only reachable on the Snapdragon machine's own localhost otherwise).
# Must include the /mcp suffix.
MCP_URL=https://your-mcp-tunnel.example.com/mcp

# Optional: HMAC-signs tool approvals so a client can't forge one.
# Generate with: openssl rand -base64 32
TOOL_APPROVAL_SECRET=
